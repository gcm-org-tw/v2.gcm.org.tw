---
import '../styles/variables.css';
import '../styles/global.css';
import SchemaOrg from '../components/SchemaOrg.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  breadcrumb?: { href: string; label: string }[];
}
const {
  title,
  description,
  ogType = 'website',
  ogImage,
  publishedTime,
  modifiedTime,
  noindex = false,
  breadcrumb = [],
} = Astro.props;

const SITE_NAME = 'GCM 上醫預防醫學發展協會';
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = Astro.url.pathname === '/' ? title : `${title}｜${SITE_NAME}`;
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site) : undefined;
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <SchemaOrg
      type={ogType === 'article' ? 'article' : 'website'}
      title={title}
      description={description}
      url={canonical}
      image={ogImage}
      pubDate={publishedTime}
      updatedDate={modifiedTime}
      breadcrumb={breadcrumb}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要內容</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  body {
    display: flex;
    min-height: 100vh;
    flex-direction: column;
  }
  main {
    flex: 1;
  }
  .skip-link {
    position: absolute;
    left: -9999px;
    background: var(--color-primary);
    color: var(--color-white);
    padding: 0.5rem 1rem;
  }
  .skip-link:focus {
    left: 1rem;
    top: 1rem;
    z-index: 100;
  }
</style>
