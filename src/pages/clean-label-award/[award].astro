---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { assetUrl } from '../../lib/assets.mjs';

/* 舊站的潔淨標章獎項彙整頁 /clean-label-award/{gold,silver,bronze}-award/。
 * 三條都實測 200，但 sitemap 與 REST 都沒收——2026-08-20 的網址稽核
 *（掃舊站每頁的站內連結，扣掉契約已有的）抓出來的，而且是最後僅存的兩個真缺口之一。
 * 頁面本身是同一批潔淨標章商品依獎項分組，資料用我們自己的 award 欄位。 */
export async function getStaticPaths() {
  const AWARDS = [
    { slug: 'gold-award', name: '金獎' },
    { slug: 'silver-award', name: '銀獎' },
    { slug: 'bronze-award', name: '銅獎' },
  ];
  const items = await getCollection('cleanLabel');
  return AWARDS.map(a => ({
    params: { award: a.slug },
    props: {
      name: a.name,
      items: items
        .filter(i => i.data.award === a.name)
        .sort((x, y) => y.data.pubDate.valueOf() - x.data.pubDate.valueOf()),
    },
  }));
}

const { name, items } = Astro.props;
const fmt = new Intl.DateTimeFormat('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit', timeZone: 'Asia/Taipei' });
---

<BaseLayout title={`GCM CLEAN LABEL 潔淨標章｜${name}`} description={`GCM CLEAN LABEL 潔淨標章 ${name} 認證商品。`} noindex>
  <div class="container wrap">
    <p class="kicker">GCM CLEAN LABEL 潔淨標章</p>
    <h1>{name}</h1>
    <p class="count">共 {items.length} 項</p>

    {items.length > 0 ? (
      <ul class="grid">
        {items.map(i => (
          <li>
            <a href={i.data.legacyPath}>
              {i.data.heroImage && <img src={assetUrl(i.data.heroImage)} alt="" loading="lazy" />}
              <p class="award">{name}</p>
              <p class="name">{i.data.title}</p>
              <p class="year">獲獎年份｜{fmt.format(i.data.pubDate)}</p>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">目前沒有{name}認證商品。</p>
    )}

    <p class="more"><a href="/gcm-clean-label/">看全部潔淨標章認證商品 →</a></p>
  </div>
</BaseLayout>

<style>
  .wrap { padding-block: clamp(2rem, 6vw, 3.5rem); }
  .kicker { margin: 0; color: var(--color-accent); font-size: var(--text-xs); letter-spacing: 0.1em; }
  h1 { margin: 0.35rem 0; font-size: var(--text-2xl); }
  .count { margin: 0 0 2rem; color: var(--color-ink-muted); font-size: var(--text-sm); }
  .grid {
    display: grid;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: 1fr;
  }
  .grid li { border: 1px solid var(--color-line); border-radius: 0.5rem; overflow: hidden; }
  .grid a { display: block; color: inherit; text-decoration: none; }
  .grid img { display: block; width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: contain; background: var(--color-bg-light); }
  .award { margin: 0.85rem 1rem 0; color: var(--color-accent-dark); font-size: var(--text-xs); font-weight: 700; }
  .name { margin: 0.2rem 1rem; font-size: var(--text-sm); font-weight: 700; }
  .year { margin: 0 1rem 1rem; color: var(--color-ink-muted); font-size: var(--text-xs); }
  .empty { color: var(--color-ink-soft); font-size: var(--text-sm); }
  .more { margin-top: 2rem; font-size: var(--text-sm); }
  @media (min-width: 640px) { .grid { grid-template-columns: repeat(3, 1fr); } }
</style>
