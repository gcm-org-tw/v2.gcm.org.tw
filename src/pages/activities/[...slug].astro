---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { slugFromLegacy } from '../../lib/urls';

/* 網址保留：舊站為 /activities/<slug>/，slug 取自 legacyPath。 */
export async function getStaticPaths() {
  const items = await getCollection('activities');
  return items.map(item => ({
    params: { slug: slugFromLegacy(item.data.legacyPath, '/activities/') },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<ArticleLayout
  title={item.data.title}
  description={item.data.description}
  pubDate={item.data.pubDate}
  updatedDate={item.data.updatedDate}
  heroImage={item.data.heroImage}
  heroImageAlt={item.data.heroImageAlt}
  breadcrumb={[{ href: '/activities/', label: '活動' }]}
>
  <Content />
</ArticleLayout>
