---
import { assetUrl } from '../lib/assets.mjs';

interface Props {
  href: string;
  title: string;
  description?: string;
  pubDate: Date;
  heroImage?: string;
  heroImageAlt?: string;
}
const { href, title, description, pubDate, heroImage, heroImageAlt } = Astro.props;
const fmt = new Intl.DateTimeFormat('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit', timeZone: 'Asia/Taipei' });
---

<article class="card">
  {heroImage && (
    <a class="thumb" href={href} tabindex="-1" aria-hidden="true">
      <img src={assetUrl(heroImage)} alt={heroImageAlt ?? ''} loading="lazy" />
    </a>
  )}
  <div class="body">
    <h2><a href={href}>{title}</a></h2>
    <time datetime={pubDate.toISOString()}>{fmt.format(pubDate)}</time>
    {description && <p>{description}</p>}
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    background: var(--color-white);
    box-shadow: var(--shadow-card);
    transition: box-shadow 0.2s ease;
  }
  .card:hover {
    box-shadow: var(--shadow-card-hover);
  }
  .thumb {
    display: block;
    aspect-ratio: 16 / 9;
    background: var(--color-bg-light);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .body {
    padding: 1.25rem;
  }
  h2 {
    margin: 0 0 0.5rem;
    font-size: var(--text-lg);
    line-height: 1.4;
  }
  h2 a {
    color: var(--color-text);
    text-decoration: none;
  }
  h2 a:hover {
    color: var(--color-primary);
  }
  time {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }
  p {
    margin: 0.75rem 0 0;
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
