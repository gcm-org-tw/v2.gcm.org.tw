---
/* 頁尾連結沿用舊站既有頁面（網址保留契約內），待正式網站地圖確認後調整。 */
/* 頁尾連結與用語取自舊站本尊的頁尾（關於協會／組職成員／醫友專欄／新聞媒體報導／
 * 聯絡我們／隱私權政策／免責聲明），不自行改名。 */
const links = [
  { href: '/about/', label: '關於協會' },
  { href: '/member/', label: '組職成員' },
  { href: '/blog/', label: '醫友專欄' },
  { href: '/媒體報導/', label: '新聞媒體報導' },
  { href: '/contact/', label: '聯絡我們' },
  { href: '/donate/', label: '捐款支持' },
  { href: '/隱私權政策/', label: '隱私權政策' },
  { href: '/disclaimer/', label: '免責聲明' },
];
const year = new Date().getFullYear();
---

<footer>
  <div class="container inner">
    <nav aria-label="頁尾導覽">
      <ul>
        {links.map(l => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <p class="copy">© {year} GCM上醫預防醫學發展協會</p>
  </div>
</footer>

<style>
  footer {
    margin-top: clamp(3rem, 8vw, 5rem);
    border-top: 1px solid var(--color-line);
    background: var(--color-bg-light);
  }
  .inner {
    padding-block: clamp(2rem, 5vw, 3rem);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }
  a {
    font-size: var(--text-sm);
    color: var(--color-text);
    text-decoration: none;
  }
  a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }
  .copy {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--color-ink-soft);
  }
</style>
