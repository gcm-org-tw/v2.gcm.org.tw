---
import { assetUrl } from '../lib/assets.mjs';

/* 選單結構、用語與階層**一比一取自舊站本尊的導覽列**（2026-08-19 從 gcm.org.tw 首頁的
 * elementor-nav-menu 逐項擷取，含 menu-item-has-children 判定），不是自行歸納的。
 * 舊站的頂層是七項：首頁／醫友健賞團（本身無連結，只是下拉）／醫友專欄／潔淨標章／
 * Gnews／關於協會／聯絡我們。
 * 註冊、忘記密碼、發表文章在舊站就在選單裡，新站也照放——那三頁目前是保留網址的
 * 靜態殼（frontmatter dynamic: true、路由掛 noindex），等 Cloudflare 動態層接上才會真的能用。 */
const nav = [
  { label: '首頁', href: '/' },
  {
    label: '醫友健賞團',
    children: [
      { href: '/activities/', label: '醫友活動' },
      { href: '/醫友健賞團/', label: '醫友健賞團' },
      { href: '/wom/', label: '醫友體驗商品大賞' },
      { href: '/醫友招募/', label: '醫友招募' },
      { href: '/register/', label: '醫友註冊/登入' },
      { href: '/mem_pwd_reset/', label: '忘記/重設密碼' },
      { href: '/post_adding/', label: '醫友發表文章' },
    ],
  },
  { label: '醫友專欄', href: '/blog/' },
  {
    label: '潔淨標章',
    href: '/gcm-clean-label/',
    children: [
      { href: '/gcm-clean-label-潔淨標章/', label: '加入 GCM CLEAN LABEL 潔淨標章' },
    ],
  },
  { label: 'Gnews', href: '/blog-cate/gcm-news/' },
  {
    label: '關於協會',
    href: '/about/',
    children: [
      { href: '/member/', label: '協會成員' },
      { href: '/媒體報導/', label: '媒體報導' },
    ],
  },
  { label: '聯絡我們', href: '/contact/' },
];

// 舊站頁首的協會 logo
const LOGO = '/wp-content/uploads/2023/03/GCM-logo-sml.png';

const path = decodeURIComponent(Astro.url.pathname);
const isCurrent = (href?: string) =>
  !!href && (path === href || (href !== '/' && path.startsWith(href)));
const groupCurrent = (item: { href?: string; children?: { href: string }[] }) =>
  isCurrent(item.href) || (item.children ?? []).some(c => isCurrent(c.href));
---

<header>
  <div class="container bar">
    <a class="brand" href="/">
      <img src={assetUrl(LOGO)} alt="" width="48" height="48" />
      <span class="name">上醫預防醫學發展協會</span>
    </a>
    <nav aria-label="主要導覽">
      <ul class="top">
        {nav.map(item => (
          <li class={item.children ? 'has-sub' : undefined}>
            {item.href
              ? <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
              /* 舊站的「醫友健賞團」頂層只是下拉開關、本身沒有連結 → 用 button 而不是空 a，
                 鍵盤才走得到，也不會產生一條指向 # 的死連結 */
              : <button type="button" aria-expanded="false" class={groupCurrent(item) ? 'current' : undefined}>{item.label}</button>}
            {item.children && (
              <ul class="sub">
                {item.children.map(c => (
                  <li>
                    <a href={c.href} aria-current={isCurrent(c.href) ? 'page' : undefined}>{c.label}</a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  header {
    border-bottom: 1px solid var(--color-line);
    background: var(--color-white);
  }
  .bar {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-block: 1rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 700;
  }
  .brand img {
    width: 3rem;
    height: 3rem;
    object-fit: contain;
  }
  .name {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }
  .top > li > a,
  .top > li > button {
    display: inline-block;
    padding: 0.25rem 0;
    font-family: inherit;
    font-size: var(--text-sm);
    color: var(--color-text);
    text-decoration: none;
    /* 「醫友健賞團」在舊站是純下拉開關，用 button 保無障礙；外觀要跟其他選單項一致 */
    border: 0;
    background: none;
    cursor: pointer;
  }
  .top > li > a:hover,
  .top > li > button:hover,
  .top > li > a[aria-current='page'],
  .top > li > button.current {
    color: var(--color-primary);
    text-decoration: underline;
  }
  /* 手機一律展開子項；桌機才收成下拉，避免沒有 JS 就點不到子頁 */
  .sub {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    padding-left: 1rem;
  }
  .sub a {
    font-size: var(--text-xs);
    color: var(--color-ink-soft);
    text-decoration: none;
  }
  .sub a:hover,
  .sub a[aria-current='page'] {
    color: var(--color-primary);
  }

  @media (min-width: 1024px) {
    .bar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
    .top > li {
      position: relative;
    }
    .sub {
      position: absolute;
      z-index: 10;
      top: 100%;
      left: 0;
      display: none;
      min-width: 12rem;
      flex-direction: column;
      gap: 0;
      padding: 0.5rem 0;
      border: 1px solid var(--color-line);
      border-radius: 0.375rem;
      background: var(--color-white);
      box-shadow: var(--shadow-card);
    }
    .top > li:hover .sub,
    .top > li:focus-within .sub {
      display: flex;
    }
    .sub li a {
      display: block;
      padding: 0.4rem 1rem;
      white-space: nowrap;
    }
  }
</style>
