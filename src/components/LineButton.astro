---
/* 浮動 LINE 諮詢鈕。舊站是 GetButton.io 的外掛 widget（外部 CDN 腳本），
 * 新站設計規範禁外部 CDN，所以改成同樣位置、同樣文案與顏色的原生連結——
 * 沒有 JavaScript、也不載第三方腳本，行為一樣是點了開 LINE 加好友。
 * 帳號網址 lin.ee/5VsKP4T 取自舊站的 widget 設定（call_to_action「添加好友」、position right）。 */
const LINE_URL = 'https://lin.ee/5VsKP4T';
---

<a class="chat" href={LINE_URL} target="_blank" rel="noopener">
  <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M12 2C6.5 2 2 5.7 2 10.2c0 4 3.6 7.4 8.4 8 .3.07.8.22.9.5.1.26.07.66.03.92l-.14.86c-.04.26-.2 1 .9.55 1.1-.46 5.9-3.48 8.05-5.96C21.5 13.4 22 11.9 22 10.2 22 5.7 17.5 2 12 2Zm-4.4 10.9H5.9c-.24 0-.43-.2-.43-.44V8.6c0-.24.2-.43.43-.43.24 0 .44.2.44.43v3.42h1.26c.24 0 .44.2.44.44 0 .24-.2.44-.44.44Zm1.9-.44c0 .24-.2.44-.44.44a.44.44 0 0 1-.44-.44V8.6c0-.24.2-.43.44-.43.24 0 .44.2.44.43v3.86Zm4.5 0c0 .19-.12.36-.3.42a.45.45 0 0 1-.14.02.44.44 0 0 1-.35-.18l-1.98-2.7v2.44c0 .24-.2.44-.44.44a.44.44 0 0 1-.44-.44V8.6c0-.19.12-.35.3-.41a.44.44 0 0 1 .5.16l1.98 2.7V8.6c0-.24.2-.43.44-.43.24 0 .43.2.43.43v3.86Zm3-2.37c.24 0 .44.2.44.44 0 .24-.2.44-.44.44h-1.26v.81h1.26c.24 0 .44.2.44.44 0 .24-.2.44-.44.44h-1.7a.44.44 0 0 1-.43-.44V8.6c0-.24.2-.43.44-.43h1.7c.23 0 .43.2.43.43 0 .25-.2.44-.44.44h-1.26v.81h1.26Z"
    />
  </svg>
  <span>添加好友</span>
</a>

<style>
  .chat {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 50;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.1rem;
    border-radius: 999px;
    background: var(--color-chat);
    color: var(--color-white);
    font-size: var(--text-xs);
    font-weight: 700;
    text-decoration: none;
    box-shadow: var(--shadow-float);
  }
  .chat:hover,
  .chat:focus-visible {
    background: var(--color-chat-dark);
  }
  @media (max-width: 639px) {
    /* 手機上只留圖示，不擋內容 */
    .chat span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    .chat {
      padding: 0.75rem;
    }
  }
</style>
