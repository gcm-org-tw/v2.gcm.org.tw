---
/* 作者簡介卡。舊站每篇文章正文之後都有這一塊（照片、姓名、職稱、專長項目、經歷），
 * 資料在 /author/<id>/ 專頁上，由 scripts/wp-authors.mjs 抓回、落成 src/data/authors.json。
 * 舊站部分作者的欄位寫著「資料登錄中⋯」，照原樣顯示，不代為補寫。 */
import { assetUrl } from '../lib/assets.mjs';
import authors from '../data/authors.json';

interface Props {
  authorId?: number;
  name?: string;
  role?: string;
}
const { authorId, name, role } = Astro.props;

type Author = { name: string; role: string; specialty: string; career: string; photo: string };
const record = (authors as Record<string, Author>)[String(authorId)];
const shownName = record?.name || name;
const shownRole = record?.role || role;
const lines = (s?: string) => (s ? s.split('\n').map(l => l.trim()).filter(Boolean) : []);
---

{shownName && (
  <aside class="author" aria-label="作者簡介">
    {record?.photo && <img src={assetUrl(record.photo)} alt="" width="96" height="96" loading="lazy" />}
    <div class="body">
      <p class="name">
        {shownRole && <span class="role">{shownRole}</span>}
        {shownName}
      </p>
      {lines(record?.specialty).map(l => <p class="line">{l}</p>)}
      {record?.career && (
        <>
          <p class="label">經歷</p>
          {lines(record.career).map(l => <p class="line">{l}</p>)}
        </>
      )}
    </div>
  </aside>
)}

<style>
  .author {
    display: flex;
    gap: 1.25rem;
    margin-top: 2.5rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    background: var(--color-bg-light);
  }
  .author img {
    flex: none;
    width: 6rem;
    height: 6rem;
    border-radius: 50%;
    object-fit: cover;
  }
  .body {
    min-width: 0;
  }
  .name {
    margin: 0 0 0.5rem;
    font-size: var(--text-lg);
    font-weight: 700;
  }
  .role {
    margin-right: 0.5rem;
    color: var(--color-primary);
    font-size: var(--text-sm);
  }
  .label {
    margin: 0.75rem 0 0.25rem;
    color: var(--color-ink-soft);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .line {
    margin: 0.2rem 0;
    font-size: var(--text-xs);
    line-height: 1.8;
    color: var(--color-ink-soft);
    overflow-wrap: anywhere;
  }
  @media (max-width: 639px) {
    .author {
      flex-direction: column;
    }
  }
</style>
